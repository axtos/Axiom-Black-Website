# Contact form (Resend). Set these in Vercel > Project > Settings > Environment Variables.
RESEND_API_KEY=
# Where enquiries are delivered
CONTACT_TO_EMAIL=info@axiomblack.com
# Must be on a domain verified in Resend, e.g. "Axiom Black Website <website@axiomblack.com>".
# Unset, it falls back to Resend's shared test sender, which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=
